# =========================================================
# KONFIGURASI ENVIRONMENT: HIJ APPS (Hostinger Production)
# Subdomain: apps.hasilintijualan.com
# =========================================================

# Lingkungan Aplikasi
NODE_ENV=production
PORT=3000

# Kredensial Admin Utama (Opsional: jika diset, dapat digunakan untuk login darurat / master)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GantiDenganPasswordKuatAnda123!

# =========================================================
# KONFIGURASI DATABASE MYSQL HOSTINGER
# (Dapatkan dari Menu MySQL Databases di hPanel Hostinger)
# =========================================================
DB_HOST=localhost
DB_USER=u123456789_hijuser
DB_PASSWORD=PasswordDatabaseAnda123!
DB_NAME=u123456789_hijapps

# =========================================================
# CLOUDINARY (Opsional: Jika ingin menyimpan gambar di Cloudinary)
# =========================================================
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# =========================================================
# GOOGLE SHEETS / DRIVE (Opsional: Hanya jika menggunakan Google Sheets API)
# =========================================================
# USE_GOOGLE_SHEETS=false
# GOOGLE_SHEET_ID=your_sheet_id
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
